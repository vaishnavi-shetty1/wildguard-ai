# Frontend environment.
#
# Copy to .env.local and fill in real values. .env* is gitignored except
# this template.

# Roboflow hosted inference (WebRTC provider).
# Without these three, the dashboard runs on the bundled YOLO checkpoint
# and the Roboflow option stays hidden.
#
# NOTE: VITE_* values are inlined into the client bundle at build time, so
# the API key is visible to anyone who loads the dashboard. Use a
# workspace-restricted key. See README.md for the proxy alternative.
VITE_ROBOFLOW_API_KEY=
VITE_ROBOFLOW_WORKSPACE=vaishnavi-shetty
VITE_ROBOFLOW_WORKFLOW=ai-wgdeu

# Workflow input/output names. Defaults shown.
VITE_ROBOFLOW_IMAGE_INPUT=image
# Set to an empty value to let the server pick the annotated stream.
VITE_ROBOFLOW_STREAM_OUTPUT=output
VITE_ROBOFLOW_DATA_OUTPUT=predictions

# Inference plan and placement.
VITE_ROBOFLOW_PLAN=webrtc-gpu-medium
VITE_ROBOFLOW_REGION=us
VITE_ROBOFLOW_TIMEOUT=3600

# Override only for self-hosted or proxied Roboflow deployments.
# VITE_ROBOFLOW_SERVER_URL=